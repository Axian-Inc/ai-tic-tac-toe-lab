{
  "name": "ai-tic-tac-toe-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start:server": "tsx server/index.ts",
    "test": "npm run test:unit && npm run test:server && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:e2e": "playwright test",
    "deploy:static": "bash ./infra/deploy-static-site.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
