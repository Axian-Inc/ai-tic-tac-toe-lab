{
  "name": "ai-tic-tac-toe-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "bash -lc 'npm run dev & npm run server:start & wait'",
    "start": "node dist-server/server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:server && npm run typecheck:scripts",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start:automation": "tsx server/index.ts",
    "aws:build-scripts": "tsc -p tsconfig.scripts.json",
    "server:start": "npm run server:build && node dist-server/server/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "UI_AUTOMATION_MODE=frontend playwright test tests/e2e",
    "test:ui:full": "UI_AUTOMATION_MODE=full playwright test tests/e2e",
    "test:unit": "playwright test tests/unit",
    "aws:urls": "npm run aws:build-scripts && node dist-scripts/scripts/aws/get-deployed-urls.js",
    "test:ui:headed": "UI_AUTOMATION_MODE=frontend playwright test tests/e2e --headed",
    "test:ui:headed:full": "UI_AUTOMATION_MODE=full playwright test tests/e2e --headed",
    "aws:s3:setup": "npm run aws:build-scripts && node dist-scripts/scripts/aws/setup-s3-website.js",
    "aws:s3:deploy": "npm run aws:build-scripts && node dist-scripts/scripts/aws/deploy-s3-website.js",
    "aws:backend:setup": "npm run aws:build-scripts && node dist-scripts/scripts/aws/setup-multiplayer-service.js",
    "aws:backend:deploy": "npm run aws:build-scripts && node dist-scripts/scripts/aws/deploy-multiplayer-service.js"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "express": "^5.2.1",
    "playwright": "^1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
