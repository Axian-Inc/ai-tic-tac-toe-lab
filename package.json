{
  "name": "lil-chad-collab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test:unit": "bash scripts/run_unit_tests.sh",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:pw": "bash scripts/run_playwright_ui.sh test",
    "test:pw:ui": "bash scripts/run_playwright_ui.sh test -- tests/playwright/specs/ui",
    "test:pw:api": "bash scripts/run_playwright_api.sh test -- tests/playwright/specs/api",
    "test:pw:ui:ui": "bash scripts/run_playwright_ui.sh ui -- tests/playwright/specs/ui",
    "test:pw:headed": "bash scripts/run_playwright_ui.sh headed",
    "test:pw:debug": "bash scripts/run_playwright_ui.sh debug",
    "test:pw:report": "bash scripts/run_playwright_ui.sh report"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.19.15",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
