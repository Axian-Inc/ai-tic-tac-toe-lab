{
  "name": "tic-tac-toe-api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node HTTP API for multiplayer tic-tac-toe",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite-node --watch src/index.ts",
    "build": "vite build",
    "start": "node dist/index.js",
    "test": "tsx --test test/server.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov tsx --test test/server.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.10",
    "@types/ws": "^8.18.1",
    "c8": "^11.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-node": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
