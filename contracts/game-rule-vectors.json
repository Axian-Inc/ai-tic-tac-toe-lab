{
  "$schema": "./game-rule-vectors.schema.json",
  "version": 1,
  "gameCases": [
    {
      "name": "new game",
      "moves": [],
      "expected": {
        "status": "playing",
        "currentTurn": "X",
        "winner": null,
        "board": [null, null, null, null, null, null, null, null, null],
        "moveCount": 0
      }
    },
    {
      "name": "human wins first column",
      "moves": [
        { "player": "X", "cell": 0 },
        { "player": "O", "cell": 1 },
        { "player": "X", "cell": 3 },
        { "player": "O", "cell": 2 },
        { "player": "X", "cell": 6 }
      ],
      "expected": {
        "status": "won",
        "currentTurn": null,
        "winner": "X",
        "board": ["X", "O", "O", "X", null, null, "X", null, null],
        "moveCount": 5
      }
    },
    {
      "name": "cpu wins top row",
      "moves": [
        { "player": "X", "cell": 4 },
        { "player": "O", "cell": 0 },
        { "player": "X", "cell": 8 },
        { "player": "O", "cell": 1 },
        { "player": "X", "cell": 6 },
        { "player": "O", "cell": 2 }
      ],
      "expected": {
        "status": "won",
        "currentTurn": null,
        "winner": "O",
        "board": ["O", "O", "O", null, "X", null, "X", null, "X"],
        "moveCount": 6
      }
    },
    {
      "name": "occupied cell is rejected without mutation",
      "moves": [
        { "player": "X", "cell": 4 },
        { "player": "O", "cell": 4 }
      ],
      "rejection": { "atMove": 2, "reason": "occupied" },
      "expected": {
        "status": "playing",
        "currentTurn": "O",
        "winner": null,
        "board": [null, null, null, null, "X", null, null, null, null],
        "moveCount": 1
      }
    },
    {
      "name": "draw",
      "moves": [
        { "player": "X", "cell": 0 },
        { "player": "O", "cell": 1 },
        { "player": "X", "cell": 2 },
        { "player": "O", "cell": 4 },
        { "player": "X", "cell": 3 },
        { "player": "O", "cell": 5 },
        { "player": "X", "cell": 7 },
        { "player": "O", "cell": 6 },
        { "player": "X", "cell": 8 }
      ],
      "expected": {
        "status": "draw",
        "currentTurn": null,
        "winner": null,
        "board": ["X", "O", "X", "X", "O", "O", "O", "X", "X"],
        "moveCount": 9
      }
    }
  ],
  "cpuCases": [
    {
      "name": "chooses lowest open cell",
      "moves": [{ "player": "X", "cell": 0 }],
      "expectedMove": 1
    },
    {
      "name": "takes immediate win before lowest open cell",
      "moves": [
        { "player": "X", "cell": 4 },
        { "player": "O", "cell": 0 },
        { "player": "X", "cell": 8 },
        { "player": "O", "cell": 1 },
        { "player": "X", "cell": 6 }
      ],
      "expectedMove": 2
    }
  ]
}

