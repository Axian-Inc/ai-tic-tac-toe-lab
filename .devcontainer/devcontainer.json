{
  "name": "codex-devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "copy-codex-auth",
  "remoteEnv": {
    "AWS_DEFAULT_REGION": "us-west-2",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "mounts": [
    "source=${localEnv:USERPROFILE}/.codex,target=/tmp/host-codex,type=bind,consistency=cached,readonly"
  ]
}
